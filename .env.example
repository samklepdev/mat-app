# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit actual keys.

# Google Places API key, used to broaden Find Care search results beyond the
# SAMHSA registry (api/googlePlaces.ts). Optional: the app works fine without
# it, it just won't include Google-sourced results. See README for how to
# create a restricted key in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=<YOUR_GOOGLE_PLACES_API_KEY>